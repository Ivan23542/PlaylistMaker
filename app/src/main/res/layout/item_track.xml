<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="70dp"
    android:paddingStart="13dp"
    android:paddingTop="8dp"
    android:paddingEnd="13dp"
    android:paddingBottom="8dp">

    <ImageView
        android:id="@+id/artworkImageView"
        android:layout_width="45dp"
        android:layout_height="45dp"
        android:contentDescription="@string/track_cover"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:src="@drawable/placeholder" />

    <TextView
        android:id="@+id/trackNameTextView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/track_name_color"
        android:textSize="16sp"
        app:layout_constraintEnd_toStartOf="@+id/trackTimeTextView"
        app:layout_constraintStart_toEndOf="@id/artworkImageView"
        app:layout_constraintTop_toTopOf="@id/artworkImageView"
        tools:text="Smells Like Teen Spirit" />

    <TextView
        android:id="@+id/artistNameTextView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/track_secondary_color"
        android:textSize="11sp"
        app:layout_constraintEnd_toStartOf="@+id/trackTimeTextView"
        app:layout_constraintStart_toEndOf="@id/artworkImageView"
        app:layout_constraintTop_toBottomOf="@id/trackNameTextView"
        tools:text="Nirvana" />

    <TextView
        android:id="@+id/trackTimeTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/track_secondary_color"
        android:textSize="11sp"
        app:layout_constraintBottom_toBottomOf="@id/artistNameTextView"
        app:layout_constraintEnd_toEndOf="parent"
        tools:text="5:01" />

</androidx.constraintlayout.widget.ConstraintLayout>