<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/playlistCoverImageView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:contentDescription="@string/playlist_cover"
        android:scaleType="centerCrop"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:shapeAppearanceOverlay="@style/PlaylistCoverShape"
        tools:src="@drawable/vector" />

    <TextView
        android:id="@+id/playlistTitleTextView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:ellipsize="end"
        android:fontFamily="@font/ys_display_regular"
        android:includeFontPadding="false"
        android:lineHeight="@dimen/playlist_grid_text_line_height"
        android:maxLines="1"
        android:textColor="@color/track_name_color"
        android:textSize="12sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/playlistCoverImageView"
        tools:text="Best songs 2021" />

    <TextView
        android:id="@+id/playlistTracksCountTextView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:fontFamily="@font/ys_display_regular"
        android:includeFontPadding="false"
        android:lineHeight="@dimen/playlist_grid_text_line_height"
        android:textColor="@color/track_secondary_color"
        android:textSize="11sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/playlistTitleTextView"
        tools:text="98 треков" />

</androidx.constraintlayout.widget.ConstraintLayout>
