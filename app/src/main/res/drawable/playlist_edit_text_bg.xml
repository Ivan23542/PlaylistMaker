<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- активное -->
    <item android:state_focused="true">
        <shape>
            <corners android:radius="12dp"/>
            <stroke android:width="1dp" android:color="@color/play_icon_color"/>
            <solid android:color="@android:color/transparent"/>
        </shape>
    </item>

    <!-- обычное -->
    <item>
        <shape>
            <corners android:radius="12dp"/>
            <stroke android:width="1dp" android:color="@color/player_small_icon_color"/>
            <solid android:color="@android:color/transparent"/>
        </shape>
    </item>

</selector>